{
    "name": "elepha",
    "version": "0.4.4",
    "description": "Local memory for AI coding tools: keeps the reasoning your commits do not.",
    "keywords": [
        "claude-code",
        "codex",
        "mcp",
        "ai-memory",
        "agent-memory",
        "coding-agent",
        "memory",
        "session-memory",
        "session-history",
        "context-management",
        "developer-tools",
        "cli",
        "local-first",
        "privacy",
        "sqlite"
    ],
    "homepage": "https://github.com/aldanux/elepha#readme",
    "bugs": {
        "url": "https://github.com/aldanux/elepha/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aldanux/elepha.git"
    },
    "license": "MPL-2.0",
    "type": "module",
    "bin": {
        "elepha": "./bin/elepha.js"
    },
    "files": [
        "dist",
        "bin"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepublishOnly": "npm run build",
        "build": "tsc -p tsconfig.json",
        "dev": "tsx watch src/cli/index.ts",
        "start": "node dist/cli/index.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
        "changeset": "changeset",
        "release": "changeset version && changeset publish",
        "format-lint": "biome check --write .",
        "format:check": "biome check ."
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.123.0",
        "@clack/prompts": "^1.7.0",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@napi-rs/keyring": "2.0.0",
        "better-sqlite3-multiple-ciphers": "13.0.3",
        "chokidar": "^5.0.0",
        "commander": "^15.0.0",
        "dbus-native": "0.15.2",
        "smol-toml": "^1.8.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@changesets/cli": "^3.0.1",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.4.1",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "allowScripts": {
        "better-sqlite3-multiple-ciphers@13.0.3": false,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    }
}
