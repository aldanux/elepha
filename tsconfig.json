{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "typeRoots": ["./src/types", "./node_modules/@types"],
        "declaration": false,
        "sourceMap": true,
        "inlineSources": true
    },
    "include": ["src"]
}
